{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@chatbot/shared": ["../../libs/shared/src/index.ts"],
      "@chatbot/shared/client": ["../../libs/shared/src/client.ts"],
      "@chatbot/shared/server": ["../../libs/shared/src/server.ts"],
      "@chatbot/ai": ["../../libs/ai/src/index.ts"],
      "@chatbot/ai/*": ["../../libs/ai/src/*"],
      "@chatbot/claw-studio": ["../../libs/claw-studio/src/index.ts"],
      "@chatbot/claw-studio/*": ["../../libs/claw-studio/src/*"],
      "@chatbot/agent-studio": ["../../libs/agent-studio/src/index.ts"],
      "@chatbot/agent-studio/server": ["../../libs/agent-studio/src/server.ts"],
      "@chatbot/agent-studio/*": ["../../libs/agent-studio/src/*"]
    },
    "isolatedModules": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
